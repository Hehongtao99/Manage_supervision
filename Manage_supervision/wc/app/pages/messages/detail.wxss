.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.message-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.message-header {
  margin-bottom: 30rpx;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.message-content {
  border-bottom: 1rpx solid #eee;
  padding-bottom: 30rpx;
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.content-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
}

.reply-section {
  padding-bottom: 30rpx;
  margin-bottom: 30rpx;
}

.reply-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reply-content {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  background-color: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
}

.action-btns {
  display: flex;
  justify-content: center;
}

.btn {
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  text-align: center;
}

.back-btn {
  background-color: #f5f5f5;
  color: #333;
  border: 1rpx solid #ddd;
} 