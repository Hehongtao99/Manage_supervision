.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  padding: 10rpx 30rpx;
  background-color: #4CAF50;
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.message-list {
  padding-bottom: 20rpx;
}

.message-item {
  margin-bottom: 20rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.message-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.message-info {
  display: flex;
  align-items: center;
}

.student-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.teacher-name {
  font-size: 28rpx;
  color: #666;
}

.message-time {
  font-size: 24rpx;
  color: #999;
}

.message-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.message-status {
  display: flex;
  justify-content: flex-end;
}

.reply-indicator {
  font-size: 26rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.reply-indicator.read {
  background-color: #e8f5e9;
  color: #4CAF50;
}

.reply-indicator.unread {
  background-color: #ffebee;
  color: #f44336;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 40rpx;
  color: #bbb;
  margin-bottom: 20rpx;
  background-color: #f0f0f0;
  border-radius: 50%;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

/* 弹窗样式 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 10;
}

.dialog-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx;
  z-index: 11;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  text-align: center;
}

.dialog-content {
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 30rpx;
  margin-bottom: 20rpx;
  color: #333;
}

.picker-text {
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 30rpx;
  color: #333;
}

.message-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.dialog-footer {
  display: flex;
  justify-content: space-between;
}

.dialog-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.cancel-btn {
  margin-right: 20rpx;
  background-color: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background-color: #4CAF50;
  color: #fff;
}

.error-text {
  color: #f44336;
  font-size: 26rpx;
  text-align: center;
  padding: 10rpx 0;
}

.loading-text {
  color: #4CAF50;
  font-size: 26rpx;
  text-align: center;
  padding: 10rpx 0;
} 