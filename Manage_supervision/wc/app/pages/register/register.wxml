<!-- pages/register/register.wxml -->
<view class="container">
  <view class="header">
    <text class="title">账号注册</text>
    <text class="subtitle">请填写以下信息完成注册</text>
  </view>
  
  <view class="form-container">
    <view class="form-item">
      <text class="form-label">用户名</text>
      <input 
        class="form-input" 
        value="{{username}}" 
        placeholder="请输入用户名（至少4个字符）"
        data-field="username"
        bindinput="onInputChange"
      />
    </view>
    
    <view class="form-item">
      <text class="form-label">密码</text>
      <view class="password-input-container">
        <input 
          class="form-input password-input" 
          value="{{password}}" 
          password="{{!showPassword}}"
          placeholder="请输入密码（至少6个字符）"
          data-field="password"
          bindinput="onInputChange"
        />
        <view class="password-toggle" data-field="showPassword" bindtap="togglePasswordVisibility">
          <image class="eye-icon" src="{{showPassword ? '/assets/icons/eye-open.png' : '/assets/icons/eye-close.png'}}"></image>
        </view>
      </view>
    </view>
    
    <view class="form-item">
      <text class="form-label">确认密码</text>
      <view class="password-input-container">
        <input 
          class="form-input password-input" 
          value="{{confirmPassword}}" 
          password="{{!showConfirmPassword}}"
          placeholder="请再次输入密码"
          data-field="confirmPassword"
          bindinput="onInputChange"
        />
        <view class="password-toggle" data-field="showConfirmPassword" bindtap="togglePasswordVisibility">
          <image class="eye-icon" src="{{showConfirmPassword ? '/assets/icons/eye-open.png' : '/assets/icons/eye-close.png'}}"></image>
        </view>
      </view>
    </view>
    
    <view class="form-item">
      <text class="form-label">手机号码</text>
      <input 
        class="form-input" 
        value="{{phone}}" 
        type="number"
        maxlength="11"
        placeholder="请输入手机号码"
        data-field="phone"
        bindinput="onInputChange"
      />
    </view>
    
    <view class="form-item">
      <text class="form-label">真实姓名</text>
      <input 
        class="form-input" 
        value="{{realName}}" 
        placeholder="请输入真实姓名"
        data-field="realName"
        bindinput="onInputChange"
      />
    </view>
    
    <view class="error-message" wx:if="{{errorMessage}}">
      <text>{{errorMessage}}</text>
    </view>
    
    <button 
      class="register-btn" 
      type="primary"
      loading="{{isLoading}}"
      bindtap="register"
    >注册</button>
    
    <view class="login-link">
      <text>已有账号？</text>
      <text class="link" bindtap="goToLogin">返回登录</text>
    </view>
  </view>
</view> 