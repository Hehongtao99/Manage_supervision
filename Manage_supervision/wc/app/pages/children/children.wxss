/* pages/children/children.wxss */
.container {
  padding: 0;
  min-height: 100vh;
  background-color: #f8f8f8;
}

.header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  font-size: 28rpx;
  color: #fff;
  background-color: #4CAF50;
  border-radius: 30rpx;
  padding: 0 30rpx;
  height: 64rpx;
  line-height: 64rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
}

.loading {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 内容区域 */
.content {
  padding: 20rpx;
}

/* 子女列表 */
.children-list {
  display: flex;
  flex-direction: column;
}

.child-card {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.child-info {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.child-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 1rpx solid #eee;
}

.child-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.name-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.child-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

/* 状态标签样式 */
.status-tag {
  padding: 4rpx 12rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.status-active {
  background-color: #e8f5e9;
}

.status-pending {
  background-color: #fff3e0;
}

.status-inactive {
  background-color: #f5f5f5;
}

.status-text {
  font-size: 22rpx;
}

.status-active .status-text {
  color: #4CAF50;
}

.status-pending .status-text {
  color: #FF9800;
}

.status-inactive .status-text {
  color: #9E9E9E;
}

.child-id, .child-class {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.relation-tag {
  display: inline-block;
  background-color: #e8f5e9;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  margin-top: 10rpx;
}

.relation-text {
  font-size: 24rpx;
  color: #4CAF50;
}

/* 操作按钮区 */
.child-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-radius: 6rpx;
}

.detail-btn {
  color: #4CAF50;
  background-color: #e8f5e9;
  margin-right: 10rpx;
}

.unrelate-btn {
  color: #f44336;
  background-color: #ffebee;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
} 