.container {
  padding: 0;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  position: relative;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #e0e0e0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
}

.content {
  padding: 30rpx;
}

/* 搜索区域 */
.search-container {
  margin-bottom: 30rpx;
}

.search-box {
  display: flex;
  background-color: #ffffff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333333;
  border: none;
}

.search-btn {
  width: 150rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #4CAF50;
  color: white;
  font-size: 28rpx;
}

.search-tip {
  font-size: 24rpx;
  color: #888888;
  margin-top: 10rpx;
  padding: 0 10rpx;
}

.error-msg {
  margin-top: 16rpx;
  color: #f44336;
  font-size: 24rpx;
  padding: 0 10rpx;
}

/* 加载状态 */
.loading-container {
  padding: 30rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.loading {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 搜索结果列表 */
.search-results {
  margin-bottom: 30rpx;
  background-color: #ffffff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.student-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #e0e0e0;
  position: relative;
}

.student-item:last-child {
  border-bottom: none;
}

.student-item.selected {
  background-color: #e8f5e9;
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 6rpx;
}

.student-id {
  font-size: 24rpx;
  color: #666666;
  display: block;
  margin-bottom: 4rpx;
}

.student-class {
  font-size: 24rpx;
  color: #666666;
  display: block;
}

.select-icon {
  width: 40rpx;
  height: 40rpx;
  color: #4CAF50;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 空状态 */
.empty-state {
  padding: 60rpx 40rpx;
  text-align: center;
  background-color: #ffffff;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666666;
  margin-bottom: 10rpx;
  display: block;
}

.empty-desc {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

/* 关系选择 */
.relation-section {
  background-color: #ffffff;
  border-radius: 10rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 20rpx;
}

.relation-types {
  display: flex;
  flex-wrap: wrap;
}

.relation-item {
  padding: 10rpx 20rpx;
  display: flex;
  align-items: center;
  margin-right: 30rpx;
  margin-bottom: 10rpx;
}

.relation-label {
  font-size: 28rpx;
  color: #333333;
  margin-left: 10rpx;
}

/* 按钮 */
.action-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
}

.action-btn {
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin: 0;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666666;
  border: 1rpx solid #dddddd;
}

.confirm-btn {
  background-color: #4CAF50;
  color: white;
}

.confirm-btn.disabled {
  background-color: #a5d6a7;
  opacity: 0.7;
} 