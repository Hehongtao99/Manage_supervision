/* app/pages/profile/change-password.wxss */
.password-container {
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.form-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.password-tips {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 40rpx;
  padding-left: 10rpx;
}

.form-group {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 10rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.password-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #e0e0e0;
}

.form-input {
  flex: 1;
  height: 90rpx;
  font-size: 30rpx;
  padding: 0 20rpx;
  color: #333;
}

.password-toggle {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-right: 10rpx;
}

.icon-eye {
  width: 40rpx;
  height: 40rpx;
}

/* 密码强度指示器 */
.password-strength-indicator {
  margin-top: 20rpx;
}

.strength-bar {
  height: 10rpx;
  background-color: #eee;
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.strength-progress {
  height: 100%;
  background: linear-gradient(to right, #ff4d4f, #ff7a45, #ffc53d, #73d13d, #52c41a);
  transition: width 0.3s;
}

.strength-text {
  font-size: 24rpx;
  color: #888;
  text-align: right;
}

/* 密码提示 */
.password-helper {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
}

.helper-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.helper-item {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.btn-container {
  padding: 20rpx 40rpx;
  margin-top: 40rpx;
}

.btn-submit {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(to right, #4a90e2, #5f9de9);
  color: white;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: opacity 0.3s;
}

.btn-loading {
  opacity: 0.8;
}

/* 按钮按下效果 */
.btn-submit:active {
  opacity: 0.9;
} 