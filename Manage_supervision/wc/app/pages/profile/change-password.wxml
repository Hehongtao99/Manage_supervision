<!--app/pages/profile/change-password.wxml-->
<view class="password-container">
  <view class="form-title">修改密码</view>
  <view class="password-tips">为保障账号安全，请定期修改密码</view>

  <view class="form-group">
    <!-- 当前密码 -->
    <view class="form-item">
      <text class="form-label">当前密码</text>
      <view class="password-input-wrapper">
        <input class="form-input" 
          type="{{showCurrentPassword ? 'text' : 'password'}}" 
          placeholder="请输入当前密码" 
          data-field="currentPassword" 
          bindinput="onInputChange"
          value="{{formData.currentPassword}}" />
        <view class="password-toggle" bindtap="toggleCurrentPassword">
          <image class="icon-eye" src="/assets/{{showCurrentPassword ? 'eye-open.png' : 'eye-close.png'}}"></image>
        </view>
      </view>
    </view>

    <!-- 新密码 -->
    <view class="form-item">
      <text class="form-label">新密码</text>
      <view class="password-input-wrapper">
        <input class="form-input" 
          type="{{showNewPassword ? 'text' : 'password'}}" 
          placeholder="请输入新密码(不少于6位)" 
          data-field="newPassword" 
          bindinput="onInputChange"
          value="{{formData.newPassword}}" />
        <view class="password-toggle" bindtap="toggleNewPassword">
          <image class="icon-eye" src="/assets/{{showNewPassword ? 'eye-open.png' : 'eye-close.png'}}"></image>
        </view>
      </view>
      
      <!-- 密码强度指示器 -->
      <view class="password-strength-indicator" wx:if="{{formData.newPassword}}">
        <view class="strength-bar">
          <view class="strength-progress" style="width: {{passwordStrength}}%;"></view>
        </view>
        <view class="strength-text">密码强度: {{strengthText || '弱'}}</view>
      </view>
    </view>
    
    <!-- 确认新密码 -->
    <view class="form-item">
      <text class="form-label">确认新密码</text>
      <view class="password-input-wrapper">
        <input class="form-input" 
          type="{{showConfirmPassword ? 'text' : 'password'}}" 
          placeholder="请再次输入新密码" 
          data-field="confirmPassword" 
          bindinput="onInputChange"
          value="{{formData.confirmPassword}}" />
        <view class="password-toggle" bindtap="toggleConfirmPassword">
          <image class="icon-eye" src="/assets/{{showConfirmPassword ? 'eye-open.png' : 'eye-close.png'}}"></image>
        </view>
      </view>
    </view>
  </view>

  <!-- 密码提示 -->
  <view class="password-helper">
    <view class="helper-title">密码建议:</view>
    <view class="helper-item">• 长度至少6位，建议10位以上</view>
    <view class="helper-item">• 包含大小写字母、数字和特殊符号</view>
    <view class="helper-item">• 避免使用连续数字或字母</view>
  </view>

  <!-- 提交按钮 -->
  <view class="btn-container">
    <button class="btn-submit {{isChanging ? 'btn-loading' : ''}}" 
      bindtap="changePassword" 
      disabled="{{isChanging}}">
      {{isChanging ? '修改中...' : '确认修改'}}
    </button>
  </view>
</view> 