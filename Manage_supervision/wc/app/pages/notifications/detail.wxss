.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #4CAF50;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 通知卡片 */
.notification-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.notification-header {
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 20rpx;
}

.notification-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.notification-meta {
  font-size: 28rpx;
  color: #999;
  display: flex;
  justify-content: space-between;
}

.notification-content {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  padding: 10rpx 0;
}

/* 按钮 */
.action-btns {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
}

.btn {
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  text-align: center;
}

.back-btn {
  background-color: #f5f5f5;
  color: #333;
  border: 1rpx solid #ddd;
} 